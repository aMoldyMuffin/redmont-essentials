# Monty — Discord Bot
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_bot_application_id
DISCORD_GUILD_ID=1510456262662295582

# Bot display name "Monty" is set in Discord Developer Portal → Bot → Username

# Channel where website orders are posted (create #website-orders)
ORDERS_CHANNEL_ID=

# Role allowed to claim orders (optional — Manage Messages also works)
STAFF_ROLE_ID=

# Secret shared with Cloudflare — generate a long random string
MONTY_API_SECRET=change_this_to_a_long_random_secret

# Port for order API (Railway sets PORT automatically)
API_PORT=3847

# Your live website
WEBSITE_URL=https://your-site.pages.dev

# Optional: path to SQLite database file
# DATABASE_PATH=./data/monty.db
